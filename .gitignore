# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Ruby / Bundler
# Bundler install dir (root only — assets/vendor/ holds committed front-end libs)
/vendor/
.bundle/
*.gem
*.bak

# Node
node_modules/
package-lock.json

# Logs
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini
ehthumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets — never commit
.env
.env.*
.env.local

# Docker local volumes
docker/certbot/

# Obsolete — delete this folder when done cleaning up
_obsolete/

# Local bundler lockfile (not tracked: CI and Docker resolve the Gemfile)
/Gemfile.lock

# GBA emulator build workspace (tools/gba-emulator/build.sh)
/tools/gba-emulator/.build/
